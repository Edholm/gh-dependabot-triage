<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dependabot PRs to review</title>
  <link rel="stylesheet" href="/static/style.css">
  <script src="/static/theme.js"></script>
  <script src="/static/app.js" defer></script>
</head>
<body data-polling="{{.Polling}}">
  <header>
    <h1>Dependabot PRs to review</h1>
    <div class="meta">
      {{if .Loaded}}<span>{{.Total}} open</span><span>Updated {{.Updated}}</span>{{end}}
      {{if .Refreshing}}<span class="updating" role="status">Updating…</span>{{end}}
      <form method="post" action="{{.RefreshAction}}"><button type="submit">Refresh</button></form>
    </div>
  </header>

  <main>
  {{if .Error}}
  <p class="error" role="alert">Could not fetch pull requests from GitHub: {{.Error}}</p>
  {{end}}

  {{with .Filter}}
  <p class="filter">Showing {{len $.Rows}} of {{$.Total}} pull requests from <strong>{{.Repository}}</strong> <a href="{{.ClearHref}}">Show all</a></p>
  {{end}}

  {{if .Rows}}
  <div class="selection-tools js-only" role="group" aria-label="Select pull requests">
    <span>Select</span>
    <button type="button" data-select="passing" title="Select every pull request shown with passing CI">Passing CI</button>
    <button type="button" data-select="failing" title="Select every pull request shown with failing CI">Failing CI</button>
    <button type="button" data-select="behind" title="Select every pull request shown that is behind its base branch">Behind</button>
    <button type="button" data-select="all">All</button>
    <button type="button" data-select="none">None</button>
  </div>
  <div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th class="select js-only"><input type="checkbox" class="select-all" aria-label="Select all pull requests shown"></th>
        {{range .Headers}}
        <th{{if .Sort}} aria-sort="{{.Sort}}"{{end}}><a href="{{.Href}}">{{.Label}}{{if .Arrow}} <span class="arrow" aria-hidden="true">{{.Arrow}}</span>{{end}}</a></th>
        {{end}}
        <th class="actions js-only"><span class="visually-hidden">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      {{range .Rows}}
      <tr data-key="{{.Key}}" data-url="{{.URL}}" data-ci="{{.CI.Class}}"{{if .Passing}} data-passing{{end}}{{if .Behind}} data-behind{{end}}>
        <td class="select js-only"><input type="checkbox" class="select-pr" value="{{.Key}}" aria-label="Select {{.Key}}"></td>
        <td class="repo"><a href="{{.FilterHref}}" title="Only show pull requests from {{.Repository}}"><span class="owner">{{.Owner}}</span><span class="name">{{.Name}}</span></a></td>
        <td class="title"><a href="{{.URL}}"{{if .Description}} title="{{.Description}}"{{end}} target="_blank" rel="noopener noreferrer"><span class="num">#{{.Number}}</span> {{.Title}}</a></td>
        <td class="age" title="{{.AgeTitle}}">{{.Age}}</td>
        <td><span class="badge {{.Review.Class}}">{{.Review.Label}}</span></td>
        <td>
          <span class="badge {{.Status.Class}}">{{.Status.Label}}</span>
          {{if .Behind}}<button type="button" class="row-rebase js-only" data-rebase="{{.Key}}" title="Rebase {{.Key}} onto its base branch">Rebase</button>{{end}}
          {{range .Extras}}<span class="badge {{.Class}}">{{.Label}}</span>{{end}}
        </td>
        <td><span class="badge {{.CI.Class}}">{{.CI.Label}}</span></td>
        <td class="actions js-only">{{if .Mergeable}}<button type="button" class="row-merge" data-merge="{{.Key}}" title="Approve and merge {{.Key}}">Approve &amp; merge</button>{{end}}</td>
      </tr>
      {{end}}
    </tbody>
  </table>
  </div>
  {{else if and .Loaded .Filter}}
  <p class="empty">No Dependabot pull requests from {{.Filter.Repository}} are waiting for your review.</p>
  {{else if .Loaded}}
  <p class="empty">No Dependabot pull requests are waiting for your review.</p>
  {{else if not .Error}}
  <p class="empty" role="status">Loading pull requests from GitHub… this can take a few seconds.</p>
  {{end}}
  </main>

  <aside class="island js-only" aria-label="Selection and merge queue" hidden></aside>

  <dialog class="prompt-dialog" aria-labelledby="prompt-dialog-title">
    <form method="dialog">
      <h2 id="prompt-dialog-title">AI fix prompt</h2>
      <p><code>{links}</code> is replaced by the links of the selected pull requests, one per line. Without it, the links are added at the end. The prompt is saved in this browser.</p>
      <textarea name="template" rows="14" spellcheck="false" aria-label="Prompt template"></textarea>
      <div class="dialog-actions">
        <button type="button" class="ghost" data-prompt="reset">Reset to default</button>
        <button type="submit" value="cancel">Cancel</button>
        <button type="submit" value="save" class="primary">Save</button>
      </div>
    </form>
  </dialog>

  <footer>
    <a class="github" href="https://github.com/Edholm/gh-dependabot-triage" target="_blank" rel="noopener noreferrer" aria-label="Edholm/gh-dependabot-triage on GitHub" title="Edholm/gh-dependabot-triage on GitHub">
      <svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
    </a>
    <div class="theme-switcher" role="group" aria-label="Theme" hidden>
      <span>Theme</span>
      <span class="options">
        <button type="button" data-theme="system" aria-pressed="true">System</button>
        <button type="button" data-theme="light" aria-pressed="false">Light</button>
        <button type="button" data-theme="dark" aria-pressed="false">Dark</button>
      </span>
    </div>
  </footer>
</body>
</html>
